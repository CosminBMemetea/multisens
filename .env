# Single source of truth for values shared across services in
# docker-compose.yml. ros and backend must agree on ROS_DOMAIN_ID and
# RMW_IMPLEMENTATION to see each other's DDS graph at all - this used to be
# hardcoded separately in ros2_ws/Dockerfile and docker-compose.yml (flagged
# as a duplication risk back in Phase 1, now that backend actually needs the
# same values it's fixed here instead of copied a third time).
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
