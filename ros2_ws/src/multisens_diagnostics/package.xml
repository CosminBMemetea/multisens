<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>multisens_diagnostics</name>
  <version>0.1.0</version>
  <description>MultiSens global/system diagnostics (CPU, RAM, uptime, connected sensor count) - not tied to any single sensor, so it lives outside multisens_ingestion</description>
  <maintainer email="memetea.cosmin@gmail.com">MultiSens</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>diagnostic_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
