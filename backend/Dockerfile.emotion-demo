# Opt-in overlay that installs the reference emotion-classification
# bridge plugin on top of the ordinary backend image - same reasoning
# and same self-contained structure as backend/Dockerfile.ridesafe
# (deliberately NOT `FROM multisense-backend`, since docker compose tags
# this overlay's own output as that exact name - see that file's own
# comment for the real bug this avoids).
FROM ros:humble-ros-base

RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-rmw-cyclonedds-cpp \
        python3-pip \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --upgrade pip

COPY sdk /sdk
RUN pip3 install --no-cache-dir /sdk

WORKDIR /app
COPY backend/requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

COPY backend/app ./app

COPY examples/plugins/reference-inference-emotion /tmp/reference-inference-emotion
RUN pip3 install --no-cache-dir /tmp/reference-inference-emotion

COPY backend/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
