# ROS 2 colcon build artifacts
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# mediamtx's own auto-generated TLS cert, dropped wherever it happens to
# be started from when no mediamtx.yml is found in the cwd - local dev
# noise, never project content (found twice landing inside example
# plugin directories, accidentally committed once - see git history).
auto.crt
auto.key

# Claude Code session-local state, not project content
.claude/

# Local SQLite DB backups (e.g. pre-reset snapshots) - never committed
/backups/
*.db

# Recorded/downloaded video source material - large binaries, and some
# sources carry licensing that doesn't permit redistribution. Never
# committed; see docs/development.md for how recorded replay sources are
# obtained and used locally only.
/videos/
data/recorded/
*.mp4
*.mkv
*.mov
